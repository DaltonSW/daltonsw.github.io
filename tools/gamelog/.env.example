# Copy to .env (gitignored) and fill in. `gamelog suggest` loads this file
# automatically; real environment variables always win over what's set here.

# https://retroachievements.org/settings — "Keys" section
RA_USERNAME=
RA_API_KEY=

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Either your 17-digit SteamID64, or the vanity name from your profile URL
# (steamcommunity.com/id/<vanity>) — vanity names are resolved automatically.
# STEAM_USER_ID is accepted as an alias for this.
STEAM_ID=

# Exophase profile name, for Ubisoft Connect achievements. Ubisoft has no
# public API, so this comes from a public Exophase profile — a username, not
# a secret, and the profile must be public.
# EXOPHASE_PSN_USER is accepted as an alias, from when this also covered PSN.
EXOPHASE_USER=

# npsso session value, for PSN trophies via Sony's own trophy API. Log into
# https://store.playstation.com, then in the same browser visit
# https://ca.account.sony.com/api/v1/ssocookie — the response is
# {"npsso":"<value>"}, and that value is what goes here. This IS a secret,
# and it expires after ~2 months; when `gamelog psn list`/`achievements`
# starts failing to authenticate, repeat these steps for a fresh one.
PSN_NPSSO=

# xbl.io/console — sign in with the Microsoft account whose Xbox history you
# want, then create a key on your profile page. This IS a secret: unlike the
# others above, OpenXBL has no public-profile mode, only your own account.
XBLIO_API_KEY=
